# Copy to .env (in this folder) and fill in your own keys.
# Every project loads this one shared file.

# OpenAI key (llm-cli-tool): https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-key

# OpenWeatherMap key: https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=your-openweathermap-key

# Gemini model name
GEMINI_MODEL=gemini-2.5-flash
